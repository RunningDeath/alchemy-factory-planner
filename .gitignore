# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local

# game data extractor build output
/tools/extract-game-data/bin/
/tools/extract-game-data/obj/
/dt_buildings*.json

# agent worktrees
/.claude/worktrees/

# game icons exported locally by tools/extract-game-data (game assets, not ours to commit)
/public/game-icons/
